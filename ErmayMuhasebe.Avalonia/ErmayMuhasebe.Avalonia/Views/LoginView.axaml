<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="ErmayMuhasebe.Avalonia.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <UserControl.Styles>
        <Style Selector="Button.LinkButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                     Content="{TemplateBinding Content}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.LinkButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource BackgroundBrush}" Padding="40">
        <StackPanel VerticalAlignment="Center" Spacing="20" MaxWidth="350">

            <Image Source="avares://ErmayMuhasebe.Avalonia/Assets/vk_logo.png"
                   Width="72" Height="72"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"/>

            <TextBlock Text="VK" 
                       FontSize="28" 
                       FontWeight="ExtraBold" 
                       LetterSpacing="2"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
            
            <TextBlock Text="Ön Muhasebe &amp; Finans Yönetimi" 
                       FontSize="13" 
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>

            <!-- Giriş Formu Alanı -->
            <StackPanel Spacing="10" Margin="0,15,0,0">
                <TextBlock Text="Kullanıcı Adı" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                <TextBox Text="{Binding Username}" 
                         Watermark="Kullanıcı adınızı girin"
                         Height="40"
                         VerticalContentAlignment="Center"/>
                
                <TextBlock Text="Şifre" FontWeight="SemiBold" FontSize="12" Opacity="0.8" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Password}" 
                         PasswordChar="*"
                         Watermark="••••••••"
                         Height="40"
                         VerticalContentAlignment="Center"
                         KeyDown="Password_KeyDown"/>

                <CheckBox Content="Beni Hatırla" 
                          IsChecked="{Binding RememberMe}"
                          Margin="0,10,0,12"
                          FontSize="13" 
                          Cursor="Hand"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>


            <TextBlock Text="{Binding ErrorMessage}" 
                       Foreground="#EF4444" 
                       FontSize="12" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <TextBlock Text="{Binding SuccessMessage}" 
                       Foreground="#4ADE80" 
                       FontSize="12" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Button Command="{Binding LoginCommand}" 
                    Content="Giriş Yap" 
                    Background="#2563EB" 
                    Foreground="White" 
                    Height="45"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontWeight="Bold"
                    IsEnabled="{Binding !IsBusy}">
                <Button.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    </Transitions>
                </Button.Transitions>
            </Button>

            <ProgressBar IsIndeterminate="True" 
                         IsVisible="{Binding IsBusy}" 
                         Height="2" 
                         Margin="0,-5,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
