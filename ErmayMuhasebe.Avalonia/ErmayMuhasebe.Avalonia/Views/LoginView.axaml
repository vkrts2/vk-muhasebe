<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="ErmayMuhasebe.Avalonia.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <UserControl.Styles>
        <Style Selector="Button.LinkButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                     Content="{TemplateBinding Content}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.LinkButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource BackgroundBrush}" Padding="40">
        <StackPanel VerticalAlignment="Center" Spacing="20" MaxWidth="350">

            <Image Source="avares://ErmayMuhasebe.Avalonia/Assets/vk_logo.png"
                   Width="72" Height="72"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"/>

            <TextBlock Text="VK" 
                       FontSize="28" 
                       FontWeight="ExtraBold" 
                       LetterSpacing="2"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
            
            <TextBlock Text="Ön Muhasebe &amp; Finans Yönetimi" 
                       FontSize="13" 
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>

            <!-- Giriş Formu Alanı -->
            <StackPanel Spacing="10" Margin="0,15,0,0" IsVisible="{Binding !ShowResetPasswordPanel}">
                <TextBlock Text="Kullanıcı Adı" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                <TextBox Text="{Binding Username}" 
                         Watermark="Kullanıcı adınızı girin"
                         Height="40"
                         VerticalContentAlignment="Center"/>
                
                <TextBlock Text="Şifre" FontWeight="SemiBold" FontSize="12" Opacity="0.8" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Password}" 
                         PasswordChar="*"
                         Watermark="••••••••"
                         Height="40"
                         VerticalContentAlignment="Center"
                         KeyDown="Password_KeyDown"/>

                <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,12" VerticalAlignment="Center">
                    <CheckBox Grid.Column="0" Content="Beni Hatırla" 
                              IsChecked="{Binding RememberMe}"
                              FontSize="13" 
                              Cursor="Hand"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextBrush}"/>
                    
                    <Button Grid.Column="1" 
                            Command="{Binding ForgotPasswordCommand}"
                            Classes="LinkButton"
                            VerticalAlignment="Center">
                        <TextBlock Text="Şifremi Unuttum?" 
                                   FontSize="13" 
                                   FontWeight="Medium" 
                                   Foreground="#60A5FA"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Şifre Kurtarma Paneli (E-posta) -->
            <StackPanel Spacing="15" Margin="0,20,0,0" IsVisible="{Binding ShowResetPasswordPanel}">
                <TextBlock Text="Şifre Kurtarma / Sıfırlama" FontSize="16" FontWeight="Bold" Foreground="#F43F5E" HorizontalAlignment="Center"/>
                
                <!-- Aşama 1: Kullanıcı Adı veya E-posta Girme ve Kod İsteme -->
                <StackPanel Spacing="10" IsVisible="{Binding !IsResetCodeSent}">
                    <TextBlock Text="Kullanıcı adınızı veya kayıtlı e-posta adresinizi girip 6 haneli doğrulama kodu talep edebilirsiniz." FontSize="12" Foreground="#94a3b8" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBox Text="{Binding ResetUsername}" Watermark="Kullanıcı Adı veya E-posta" Height="40" CornerRadius="8"/>

                    <Button Command="{Binding SendResetCodeCommand}" Content="E-posta ile Doğrulama Kodu Gönder" Classes="Primary" Height="40" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- Aşama 2: 6 Haneli Doğrulama Kodunu Girme ve Doğrulama -->
                <StackPanel Spacing="10" IsVisible="{Binding ShowVerifyResetCodePanel}">
                    <TextBlock Text="E-posta adresinize gönderilen 6 haneli doğrulama kodunu girin." FontSize="12" Foreground="#94a3b8" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <TextBox Text="{Binding ResetVerificationCode}" Watermark="6 Haneli Kod" Height="40" CornerRadius="8"/>
                    <Button Command="{Binding VerifyResetCodeCommand}" Content="Kodu Doğrula" Classes="Warning" Height="40" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- Aşama 3: Yeni Şifre Tanımlama -->
                <StackPanel Spacing="10" IsVisible="{Binding IsResetCodeVerified}">
                    <TextBlock Text="Doğrulama başarılı! Lütfen yeni şifrenizi belirleyin." FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" TextAlignment="Center"/>
                    
                    <TextBox PasswordChar="*" Text="{Binding ResetNewPassword}" Watermark="Yeni Şifre Belirleyin" Height="40" CornerRadius="8"/>

                    <Button Command="{Binding ConfirmResetPasswordCommand}" Content="Şifreyi Güncelle" Classes="Danger" Height="40" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- Giriş Ekranına Dön Butonu -->
                <Button Command="{Binding ForgotPasswordCommand}" Classes="LinkButton" HorizontalAlignment="Center">
                    <TextBlock Text="← Giriş Ekranına Dön" FontSize="13" Foreground="#60A5FA"/>
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" 
                       Foreground="#EF4444" 
                       FontSize="12" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <TextBlock Text="{Binding SuccessMessage}" 
                       Foreground="#4ADE80" 
                       FontSize="12" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Button Command="{Binding LoginCommand}" 
                    Content="Giriş Yap" 
                    Background="#2563EB" 
                    Foreground="White" 
                    Height="45"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontWeight="Bold"
                    IsVisible="{Binding !ShowResetPasswordPanel}"
                    IsEnabled="{Binding !IsBusy}">
                <Button.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    </Transitions>
                </Button.Transitions>
            </Button>

            <ProgressBar IsIndeterminate="True" 
                         IsVisible="{Binding IsBusy}" 
                         Height="2" 
                         Margin="0,-5,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
